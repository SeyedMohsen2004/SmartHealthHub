DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=local-development-only-secret-key-change-before-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

POSTGRES_DB=smarthealthhub
POSTGRES_USER=smarthealthhub
POSTGRES_PASSWORD=smarthealthhub_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7

LOG_LEVEL=INFO

# Production only: enable this only behind a trusted proxy that overwrites
# X-Forwarded-Proto.
DJANGO_TRUST_X_FORWARDED_PROTO=False
