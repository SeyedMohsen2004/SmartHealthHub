# Copy to a private file and replace every blank required value before use.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TRUST_X_FORWARDED_PROTO=True
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000

# Keep 0 unless the application is behind a known number of trusted proxies.
DRF_NUM_PROXIES=0
DRF_ANON_THROTTLE_RATE=100/hour
DRF_USER_THROTTLE_RATE=1000/hour
DRF_AUTH_REGISTER_THROTTLE_RATE=5/hour
DRF_AUTH_LOGIN_THROTTLE_RATE=10/min
DRF_AUTH_REFRESH_THROTTLE_RATE=30/min
DRF_AUTH_LOGOUT_THROTTLE_RATE=30/min

POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

CELERY_BROKER_URL=redis://redis:6379/0
APPOINTMENT_REMINDER_LEAD_HOURS=24
APPOINTMENT_REMINDER_SCAN_INTERVAL_SECONDS=60
APPOINTMENT_REMINDER_BATCH_SIZE=500

APP_PORT=8000
APP_UID=10001
APP_GID=10001
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=30
GUNICORN_GRACEFUL_TIMEOUT=30
LOG_LEVEL=INFO
